/* sample.rcss */
body {
    background-color: rgba(0, 0, 0, 0.7); /* 更深的半透明背景 */
    border: 2px solid #00FFFF; /* 青色边框 */
    border-radius: 10px;
    box-shadow: 0px 0px 15px rgba(0, 255, 255, 0.5); /* 青色光晕效果 */
}

h1 {
    font-size: 24px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

p {
    font-size: 14px;
    line-height: 1.5;
}

button {
    font-size: 16px;
    font-weight: bold;
    transition: background-color 0.2s ease;
}

button:active {
    background-color: #003366;
    transform: translateY(1px);
}